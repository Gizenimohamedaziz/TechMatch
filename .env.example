# Configuration - Module 4 TechMatch (ESPRIT A.U 2026-2027)
# Auteur : Aziz
#
# INSTRUCTIONS :
# 1. Copie ce fichier : copy .env.example .env
# 2. Remplis LLM_API_KEY avec ta vraie cle Groq
# 3. Ne JAMAIS commiter .env sur GitHub

# LLM (Groq gratuit en developpement)
# Creer un compte sur https://console.groq.com -> API Keys
LLM_API_KEY=REMPLACE_PAR_TA_CLE_GROQ_ICI
LLM_BASE_URL=https://api.groq.com/openai
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=60

# Base de donnees
# Laisser vide = SQLite automatique (parfait pour les tests locaux)
# Pour PostgreSQL : postgresql://user:password@localhost:5432/techmatch
DATABASE_URL=

# Parametres de l'application
DEBUG=true
